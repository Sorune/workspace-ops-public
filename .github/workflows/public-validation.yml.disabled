name: Public repository validation

on:
  pull_request:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Compile validators
        run: python -m compileall -q scripts

      - name: Validate public safety
        run: python scripts/validate_public_safety.py

      - name: Validate Markdown local links
        run: python scripts/validate_markdown_links.py
